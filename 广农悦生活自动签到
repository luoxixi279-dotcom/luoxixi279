/**
@name 广农悦生活-自动签到
@author user
@version 1.0
@description loon脚本，广农悦生活小程序自动签到，自动抓取session_id，通知展示用户名、签到数据
@time cron "0 8 * * *" // 每日早上8点自动签到
*/

const $loon = require('loon');

// ========== 配置项 ==========
const BASE_URL = "https://bigshop.gxntysh.cn";
let sessionId = $loon.read("gnysh_session_id") || "";

// 通知
function notify(title, sub, body) {
  $loon.notify(title, sub, body);
}

// 1.捕获签到页面请求，自动保存session_id（抓包该小程序访问 /ApiSign/index 时自动存储会话）
if ($loon.request && $loon.request.url.includes("/ApiSign/index")) {
  const urlObj = new URL($loon.request.url);
  const sid = urlObj.searchParams.get("session_id");
  if (sid) {
    sessionId = sid;
    $loon.write(sid, "gnysh_session_id");
    console.log(`✅捕获session_id成功: ${sid}`);
  }
  $loon.done({});
} else {
  // 定时签到逻辑
  (async function runSign() {
    if (!sessionId) {
      notify("广农悦生活签到", "❌缺少session_id", "请打开小程序访问签到页面一次，自动抓取会话");
      return;
    }

    try {
      // 获取签到用户信息 + 签到规则
      const indexResp = await $loon.fetch({
        url: `${BASE_URL}/?s=/ApiSign/index&aid=3&platform=wx&session_id=${sessionId}&pid=0&scene=1089`,
        method: "GET",
        headers: {
          "User‑Agent": "Mozilla/5.0 (WeChat MiniProgram)",
          "Referer": "https://bigshop.gxntysh.cn/"
        }
      });

      const indexJson = JSON.parse(indexResp.body);
      const user = indexJson.userinfo;
      if (!user) {
        notify("广农悦生活签到", "❌获取用户信息失败", "session失效，请重新打开签到页刷新session");
        $loon.write("", "gnysh_session_id");
        return;
      }

      const nickname = user.nickname;
      const totalSignTimes = user.signtimes;      //累计签到总次数
      const continueSign = user.signtimeslx;      //连续签到天数
      const score = user.score;                   //当前积分
      const hasSignToday = indexJson.hassign;    //1=今日已签到

      if (hasSignToday === 1) {
        notify("广农悦生活【今日已签到】", `👤用户名：${nickname}`,
`📅累计签到：${totalSignTimes}天
🔥连续签到：${continueSign}天
✨当前积分：${score}`);
        return;
      }

      // 执行签到接口
      const signResp = await $loon.fetch({
        url: `${BASE_URL}/?s=/ApiSign/sign&aid=3&platform=wx&session_id=${sessionId}`,
        method: "GET",
        headers: {
          "User‑Agent": "Mozilla/5.0 (WeChat MiniProgram)",
          "Referer": "https://bigshop.gxntysh.cn/"
        }
      });
      const signJson = JSON.parse(signResp.body);

      if (signJson.code === 1 || signJson.status === 1) {
        notify("✅广农悦生活签到成功", `👤用户名：${nickname}`,
`📅累计签到：${totalSignTimes +1}天
🔥连续签到：${continueSign +1}天
✨当前积分：${score +1}`);
      } else {
        notify("❌广农悦生活签到失败", `👤${nickname}`, `返回信息：${JSON.stringify(signJson)}`);
      }

    } catch (err) {
      notify("广农悦生活签到异常", "脚本报错", String(err));
      console.error(err);
    }
  })();
}